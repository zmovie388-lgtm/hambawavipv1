NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_PATH=./data/hambawa.sqlite
# Initial admin password is configured through setup-admin.js; never put it in frontend files.
# Run: npm run setup-admin
# Optional: set this to true only when deployed behind a correctly configured HTTPS proxy.
TRUST_PROXY=false
